# ============================================
# CyberSec Lab — Environment Variables Template
# Copy file này thành .env rồi điền giá trị thật
# cp .env.example .env
# ============================================

SECRET_KEY=your-very-secret-random-key-here

# Mail Config (Gmail App Password — bật 2FA rồi tạo App Password)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_DEFAULT_SENDER=your-email@gmail.com

# AbuseIPDB API Key — lấy tại https://www.abuseipdb.com/account/api
ABUSEIPDB_KEY=your-abuseipdb-api-key

# Target CTF Server URL
TARGET_URL=http://your-ctf-server-ip/
